{
  "compilerOptions": {
    "target": "ES2022", "module": "commonjs", "lib": ["ES2022"],
    "rootDir": "src", "outDir": "dist", "strict": true,
    "esModuleInterop": true, "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true, "noFallthroughCasesInSwitch": true
  },
  "include": ["src/**/*.ts"]
}
